#!/usr/bin/env bash
# GoTry 入口(纯 Node,无 Python 依赖;v0.0.1-rc.2 起):
#   ./gotry web                         启 dsh Web 浏览器界面
#   ./gotry "一句完整任务..."           一问一答,stdout markdown
#   ./gotry                             = 默认 web
# 前置:源仓库已经 `pnpm install`,dsh runtime 在 ts/dsh-runtime/ 内 vendored。

set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
# nvm.sh 遇 ~/.npmrc prefix 冲突会在 set -e 下 exit 整个脚本(日工作具会反复回写
# 该行)——source 期间放宽 -e/-u;之后只要 node 在 PATH 即可
set +eu
source ~/.nvm/nvm.sh 2>/dev/null || true
set -eu
command -v node >/dev/null 2>&1 || { echo "node 不可用:先装 nvm/node,或手动把 node 加进 PATH" >&2; exit 1; }
set -a; source "$ROOT/.env" 2>/dev/null || true; set +a

MODE="${1:-web}"

case "$MODE" in
  # 统一走 bin/gotry-inner.js:运行时生成 patch(插件路径按本包解析 + 宿主插件
  # 如 dsh-map-tools 注入),不再依赖 ~/.dsh/profiles 下的陈旧 patch(旧绝对路径
  # 暗中承重、宿主插件丢失的根因)。
  web|"")
    exec node "$ROOT/bin/gotry-inner.js" web "$@"
    ;;
  -h|--help|help)
    cat <<EOF
GoTry —— dsh 运行时驱动

用法:
  ./gotry web                          # dsh Web 浏览器界面 (默认)
  ./gotry "一句完整任务..."            # headless 一问一答
  ./gotry help                         # 此帮助

环境前置:
  • Node 22+
  • 已 pnpm install(ts/dsh-runtime/)
  • .env 中 LLM_API_KEY (DeepSeek / OpenAI 兼容均可)

详细文档: README.md
EOF
    ;;
  *)
    exec node "$ROOT/bin/gotry-inner.js" "$@"
    ;;
esac
