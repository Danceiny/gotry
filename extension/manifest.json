{
  "manifest_version": 3,
  "name": "Stai",
  "version": "0.2.0.26",
  "description": "Stai 连接获准的旅行检索与供应商门户：检索结果经本机或授权后端桥接；门户可触发一次性登录代填，扩展不持久保存凭据。",
  "key": "",
  "permissions": [
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:8791/*",
    "http://127.0.0.1:8792/*",
    "http://127.0.0.1:8793/*",
    "http://127.0.0.1:8794/*",
    "http://127.0.0.1:8795/*",
    "https://*.ctrip.com/*",
    "https://*.dida.com/*",
    "https://dida.com/*",
    "http://*.dida.com/*",
    "http://dida.com/*",
    "https://portal-test.hotelbyte.com/*",
    "https://portal.hotelbyte.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flights.ctrip.com/*",
        "https://hotels.ctrip.com/*",
        "https://kyfw.12306.cn/*",
        "https://www.12306.cn/*",
        "https://portal.dida.com/*"
      ],
      "js": [
        "content-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://flights.ctrip.com/*",
        "https://hotels.ctrip.com/*",
        "https://kyfw.12306.cn/*",
        "https://www.12306.cn/*",
        "https://portal.dida.com/*",
        "https://portal-test.hotelbyte.com/*",
        "https://portal.hotelbyte.com/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "version_name": "0.2.0-rc.26"
}
