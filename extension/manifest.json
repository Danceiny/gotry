{
  "manifest_version": 3,
  "name": "GoTry Session Bridge",
  "version": "0.0.1.18",
  "description": "GoTry 会话检索桥(issue #21):在你自己的登录态里只读嗅探检索回包(机票/酒店/火车)与登录票据 cookie 名;零凭证经手,登录在官网由你完成,检索只读不写。",
  "key": "",
  "permissions": [
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8791/*",
    "http://127.0.0.1:8792/*",
    "http://127.0.0.1:8793/*",
    "http://127.0.0.1:8794/*",
    "http://127.0.0.1:8795/*",
    "https://*.ctrip.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flights.ctrip.com/*",
        "https://hotels.ctrip.com/*",
        "https://kyfw.12306.cn/*",
        "https://www.12306.cn/*"
      ],
      "js": [
        "content-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://flights.ctrip.com/*",
        "https://hotels.ctrip.com/*",
        "https://kyfw.12306.cn/*",
        "https://www.12306.cn/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "version_name": "0.0.1-rc.18"
}