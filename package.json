    "ts/src/share/share-consent.ts",
    "ts/src/share/share-deck.ts",
    "ts/src/share/share-token.ts",
    "ts/src/session-link/session-link.ts",
    "ts/src/session-link/plan-it-action.ts"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "postinstall": "echo 'GoTry installed. Run: npx @danceiny/gotry web   (dsh Web UI on :3080)\\nSee: https://github.com/Danceiny/gotry'",
    "test": "bash scripts/run-all-tests.sh"
  },
