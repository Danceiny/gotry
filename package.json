{
  "name": "@danceiny/gotry",
  "version": "0.0.1-rc.18",
  "description": "GoTry — 从出发到下一次出发的 AI 旅行 Agent(dsh 插件)。npm/源码入口共用锁定的 dsh runtime + README 安装路径。",
  "type": "module",
  "main": "ts/src/index.ts",
  "exports": {
    ".": "./ts/src/index.ts",
    "./booking-surface": {
      "types": "./ts/src/booking-surface/index.ts",
      "import": "./dist/src/booking-surface/index.js",
      "default": "./dist/src/booking-surface/index.js"
    },
    "./booking-surface/schema": "./schemas/booking.surface.v1.schema.json",
    "./booking-surface/schema-v2": "./schemas/booking.surface.v2.schema.json",
    "./booking-surface/contracts-v2": {
      "types": "./ts/src/booking-surface/contracts-v2.ts",
      "import": "./dist/src/booking-surface/contracts-v2.js",
      "default": "./dist/src/booking-surface/contracts-v2.js"
    },
    "./booking-surface/validation-v2": {
      "types": "./ts/src/booking-surface/validation-v2.ts",
      "import": "./dist/src/booking-surface/validation-v2.js",
      "default": "./dist/src/booking-surface/validation-v2.js"
    },
    "./booking-surface/runtime": {
      "types": "./ts/src/booking-surface/runtime.ts",
      "import": "./dist/src/booking-surface/runtime.js",
      "default": "./dist/src/booking-surface/runtime.js"
    },
    "./booking-surface/runtime-v2": {
      "types": "./ts/src/booking-surface/runtime-v2.ts",
      "import": "./dist/src/booking-surface/runtime-v2.js",
      "default": "./dist/src/booking-surface/runtime-v2.js"
    },
    "./booking-surface/server": {
      "types": "./ts/src/booking-surface/server.ts",
      "import": "./dist/src/booking-surface/server.js",
      "default": "./dist/src/booking-surface/server.js"
    },
    "./booking-surface/server-v2": {
      "types": "./ts/src/booking-surface/server-v2.ts",
      "import": "./dist/src/booking-surface/server-v2.js",
      "default": "./dist/src/booking-surface/server-v2.js"
    },
    "./booking-surface/dsh-planner": {
      "types": "./ts/src/booking-surface/dsh-planner.ts",
      "import": "./dist/src/booking-surface/dsh-planner.js",
      "default": "./dist/src/booking-surface/dsh-planner.js"
    },
    "./booking-surface/startup": {
      "types": "./ts/src/booking-surface/startup.ts",
      "import": "./dist/src/booking-surface/startup.js",
      "default": "./dist/src/booking-surface/startup.js"
    },
    "./*": "./*"
  },
  "bin": {
    "gotry": "bin/gotry-inner.js",
    "gotry-booking-copilot": "bin/gotry-booking-copilot.js"
  },
  "files": [
    "dist/",
    "data/*.json",
    "bin/",
    "ts/src/index.ts",
    "ts/src/benchmark-environment-bridge.ts",
    "ts/src/benchmark-tool-isolation.ts",
    "ts/src/benchmark-agent-conformance.ts",
    "ts/src/benchmark-headless-child-diagnostics.ts",
    "ts/src/contracts.ts",
    "ts/src/unified.ts",
    "ts/src/model.ts",
    "ts/src/bridge.ts",
    "ts/src/loop.ts",
    "ts/src/dsh-llm.ts",
    "ts/src/mock-llm.ts",
    "ts/src/state-ledger.ts",
    "ts/src/booking-saga.ts",
    "ts/src/bookable-facts.ts",
