# .env 模板——复制为 .env 并填入你的 key
# 推荐 DeepSeek: https://platform.deepseek.com
# 也兼容任何 OpenAI 兼容端点(MiniMax/OpenAI/自建网关等)
#
# LLM_BASE_URL:可选。走 DeepSeek 官方可整行删掉;用 OpenAI 兼容端点
# (中转/MiniMax/自建网关)时必配——请求将打到 <LLM_BASE_URL>/chat/completions,
# 端点一般以 /v1 结尾(DeepSeek 官方两个形式皆可,第三方以 /v1 为准):
#   https://api.minimax.io/v1

LLM_API_KEY=你的API密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# npmjs publish(可选,见 docs/tokens.md 路径 B)
NPM_TOKEN=
