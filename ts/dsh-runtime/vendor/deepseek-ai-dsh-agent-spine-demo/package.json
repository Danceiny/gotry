    "@deepseek-ai/dsh-goal": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-goal-round-driver": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm-retry": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-session-title": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-scope": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-skill": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-jobs-local": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-shell-env": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-tool-goal": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-tool-bash": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-tool-jobs": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-tool-skill": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-agent-instructions": "^0.1.2-alpha.1",
    "@deepseek-ai/cordis": "^4.0.1"
